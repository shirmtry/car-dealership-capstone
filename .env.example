DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-new-random-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
BACKEND_URL=http://127.0.0.1:3030
SENTIMENT_URL=http://127.0.0.1:5050
MONGODB_URI=mongodb://127.0.0.1:27017/car_dealership_capstone
PORT=8000

